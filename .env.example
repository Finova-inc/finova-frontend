# =============================================================================
# Variables de entorno de finova-frontend
# =============================================================================
# Este archivo es una PLANTILLA y sí se versiona. Nunca escribas valores reales
# aquí. Para trabajar en tu máquina:
#
#     cp .env.example .env.local
#
# .env.local está ignorado por git (.gitignore ignora .env*), así que tus
# valores no salen de tu equipo.
#
# -----------------------------------------------------------------------------
# REGLA SOBRE EL PREFIJO NEXT_PUBLIC_
# -----------------------------------------------------------------------------
# Next.js incrusta en el bundle del navegador toda variable que empiece con
# NEXT_PUBLIC_. Eso significa que cualquier persona puede leerla desde las
# herramientas de desarrollo. Una URL de API no es un secreto y puede llevar el
# prefijo; una contraseña, una clave de API de un LLM o un token del SII NO.
# Esos van sin prefijo y solo se leen desde componentes de servidor, o mejor,
# viven únicamente en el backend NestJS.
# =============================================================================


# -----------------------------------------------------------------------------
# Backend NestJS
# -----------------------------------------------------------------------------
# URL pública del backend, sin barra final.
#
#   Desarrollo local  http://localhost:3001
#     (el backend arranca en 3000 por defecto, igual que Next; cambia uno de los
#      dos. Lo habitual es dejar Next en 3000 y levantar Nest con PORT=3001.)
#
#   Producción        https://api.finova.cl
#     Debe ser HTTPS. Si el frontend está en HTTPS y la API en HTTP, el
#     navegador bloquea la llamada por contenido mixto y además la cabecera
#     upgrade-insecure-requests de next.config.ts la reescribe a HTTPS.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Opcional. URL que usan SOLO los componentes de servidor de Next (no lleva
# prefijo NEXT_PUBLIC_, así que jamás llega al navegador). Úsala cuando el
# backend sea alcanzable por una red privada más corta que la ruta pública.
# Si no la defines, el servidor usa NEXT_PUBLIC_API_URL.
# API_URL_INTERNA=http://finova-backend.internal:3001


# -----------------------------------------------------------------------------
# Content Security Policy
# -----------------------------------------------------------------------------
# next.config.ts declara connect-src con el propio origen más lo que pongas
# aquí. Sin esto, el navegador bloquea silenciosamente TODO fetch hacia el
# backend en producción: la petición ni siquiera sale, y en la consola aparece
# un error de CSP, no uno de red.
#
# Acepta varios orígenes separados por espacio. Solo esquema y host, sin ruta.
CSP_CONNECT_SRC=http://localhost:3001


# -----------------------------------------------------------------------------
# Metadatos del sitio
# -----------------------------------------------------------------------------
# URL canónica del despliegue. Next la usa para resolver las URLs absolutas de
# Open Graph. En Vercel puedes dejarla vacía en Preview y definirla solo en
# Production, donde el dominio es estable.
# NEXT_PUBLIC_SITE_URL=https://finova.cl
