# Copiar a .env.local para desarrollo:  cp .env.example .env.local
#
# ATENCIÓN: NEXT_PUBLIC_API_URL y CSP_CONNECT_SRC se leen en tiempo de BUILD.
# Cambiarlas en el panel de Vercel no afecta a un deployment ya publicado:
# hay que volver a desplegar SIN caché.

# URL pública del backend NestJS, SIN barra final.
# Local: el contenedor de docker-compose publica el 3001.
# Producción (Render):  https://finova-backend-qkq0.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Orígenes que la CSP autoriza en connect-src. Debe ir SIEMPRE alineada con
# NEXT_PUBLIC_API_URL: si falta, el navegador bloquea las llamadas a la API
# antes de que salgan, y el único síntoma es una línea de CSP en la consola
# (ni error de red ni 4xx), así que es fácil culpar a CORS por equivocación.
# Con la arquitectura actual las llamadas salen del servidor de Next, donde la
# CSP no aplica, pero verificarBackend() sí puede llamarse desde el navegador.
CSP_CONNECT_SRC=http://localhost:3001

# Solo server components en red privada. Si se define, tiene prioridad sobre
# NEXT_PUBLIC_API_URL en las llamadas hechas desde el servidor.
# API_URL_INTERNA=http://finova-backend.internal:3001

# URL canónica del sitio, para Open Graph.
# NEXT_PUBLIC_SITE_URL=https://finova.cl
